# ---------------------------------------------------------------------------
# Proposta.ai — variáveis de ambiente
#
# Copie para `.env` (desenvolvimento) ou configure no provedor de deploy.
# NUNCA comite o `.env` real (já está no .gitignore).
# ---------------------------------------------------------------------------

# Obrigatórias -------------------------------------------------------------

# Conexão PostgreSQL usada pelo Prisma (ORM e migrations).
DATABASE_URL="postgresql://proposta:proposta@localhost:5432/propostadb?schema=public"

# Chave de assinatura dos cookies de sessão (HS256). Mínimo de 32 caracteres.
# Gere com: openssl rand -base64 32
SESSION_SECRET="gere-com-openssl-rand-base64-32"

# Usuário inicial criado pelo seed (`npm run db:seed`).
# O cadastro público está desativado; novos usuários são criados dentro do app.
# Padrões (se omitidos): demo@destrava.ai / proposta123
# ADMIN_EMAIL="admin@destrava.ai"
# ADMIN_PASSWORD="troque-esta-senha-123"
# ADMIN_NAME="Administrador"

# Opcionais ----------------------------------------------------------------

# Sentry (monitoramento de erros). Sem DSN, a integração fica desativada.
# SENTRY_DSN="https://<key>@o<org>.ingest.sentry.io/<project>"
# SENTRY_ENVIRONMENT="production"          # padrão: NODE_ENV
# SENTRY_TRACES_SAMPLE_RATE="0.1"          # 0..1 (padrão: 0 = sem tracing)

# DSN público exposto ao cliente (instrumentation-client.ts). Sem valor,
# nenhum dado é enviado pelo navegador.
# NEXT_PUBLIC_SENTRY_DSN="https://<key>@o<org>.ingest.sentry.io/<project>"
# NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"

# Nível de log do servidor: fatal | error | warn | info | debug | trace | silent
# Padrão: debug em desenvolvimento, info em produção.
# LOG_LEVEL="info"

# Cookie de sessão marcado como Secure (só enviado em HTTPS).
# Padrão: true quando NODE_ENV=production, false caso contrário.
# Defina `false` se servir a aplicação via HTTP (ex.: rede local sem TLS).
# COOKIE_SECURE="false"
